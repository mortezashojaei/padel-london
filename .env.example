# Telegram bot posting target
TELEGRAM_BOT_TOKEN=123456:REPLACE_ME
TELEGRAM_CHAT_ID=-100REPLACE_ME

# Playtomic target config
# single: monitor only PLAYTOMIC_TENANT_ID
# list: set PLAYTOMIC_TENANT_IDS as comma-separated tenant ids
# london_all: auto-discover all active London clubs (cached)
MONITOR_MODE=london_all
PRIORITY_TENANT_ID=2ab75436-9bb0-4e9c-9a6f-b12931a9ca4a
PLAYTOMIC_TENANT_ID=2ab75436-9bb0-4e9c-9a6f-b12931a9ca4a
PLAYTOMIC_TENANT_IDS=
PLAYTOMIC_SPORT_ID=PADEL

# Window config
DAYS_AHEAD=7
EXCLUDED_START_HOUR=8
EXCLUDED_END_HOUR=18

# Runner config
CHECK_INTERVAL_SECONDS=1800
DRY_RUN=false
STATE_FILE=/data/state.json
